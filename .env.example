# Salin file ini menjadi ".env" lalu isi dengan nilai lingkungan Anda sendiri.
# JANGAN PERNAH mengisi file .env.example ini dengan nilai asli/rahasia.

# Koneksi PostgreSQL (lihat docs/ARCHITECTURE.md §4 dan §1).
# Untuk pengembangan lokal tanpa instalasi PostgreSQL manual, Anda dapat
# menjalankan database Prisma Postgres lokal:
#   npx prisma dev
# lalu salin URL yang ditampilkan ke DATABASE_URL di bawah ini.
DATABASE_URL="postgresql://user:password@localhost:5432/nama_database?schema=public"

# Secret untuk menandatangani token sesi (NextAuth). WAJIB diisi nilai acak
# yang kuat dan berbeda di setiap environment. Contoh cara membuat:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# URL dasar aplikasi, dipakai oleh NextAuth untuk callback OAuth/redirect.
NEXTAUTH_URL="http://localhost:3000"

NODE_ENV="development"

# Foto produk disimpan di Supabase Storage pada project yang sama dengan
# DATABASE_URL di atas (permintaan pengguna 2026-08-20). SUPABASE_URL bisa
# didapat dari project ref di DATABASE_URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY WAJIB dari Dashboard Supabase > Project Settings
# > API > "service_role" secret key - JANGAN PERNAH memakai kunci ini di
# kode sisi klien/browser.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-photos"
